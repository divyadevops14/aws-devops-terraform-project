// =============================================================================
// TERRAFORM CI/CD PIPELINE
// =============================================================================
// Branch strategy:
//   feature/* → PR → develop → stage environment (auto-apply)
//   develop   → PR → main    → prod environment  (manual-approval required)
//
// Required Jenkins credentials:
//   AWS_ACCESS_KEY_ID     (Secret text)
//   AWS_SECRET_ACCESS_KEY (Secret text)
//   TF_VAR_db_password    (Secret text)
//
// Required Jenkins plugins:
//   - Pipeline
//   - AWS Credentials
//   - AnsiColor
//   - Slack Notification (optional)
// =============================================================================
// =============================================================================
// TERRAFORM CI/CD PIPELINE - WINDOWS JENKINS
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'prod'],
            description: 'Target environment'
        )

        booleanParam(
            name: 'DESTROY',
            defaultValue: false,
            description: 'Generate a Terraform destroy plan'
        )

        booleanParam(
            name: 'PLAN_ONLY',
            defaultValue: true,
            description: 'Plan only; do not apply or destroy resources'
        )
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        TF_IN_AUTOMATION   = 'true'
        TF_CLI_ARGS        = '-no-color'
        WORKING_DIR        = "environments/${params.ENVIRONMENT}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                bat '"C:\\terraform\\terraform.exe" version'
            }
        }

        stage('Terraform Format Check') {
            steps {
                bat '"C:\\terraform\\terraform.exe" fmt -check -recursive -diff .'
            }
        }

        stage('Terraform Validate') {
            steps {
                dir(env.WORKING_DIR) {
                    bat '"C:\\terraform\\terraform.exe" init -backend=false -input=false'
                    bat '"C:\\terraform\\terraform.exe" validate'
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir(env.WORKING_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        bat '"C:\\terraform\\terraform.exe" init -input=false -reconfigure'
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir(env.WORKING_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        script {
                            if (params.DESTROY) {
                                bat '"C:\\terraform\\terraform.exe" plan -destroy -input=false -out=tfplan'
                            } else {
                                bat '"C:\\terraform\\terraform.exe" plan -input=false -out=tfplan'
                            }
                        }

                        bat '"C:\\terraform\\terraform.exe" show -no-color tfplan > tfplan.txt'
                    }
                }
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: "${env.WORKING_DIR}/tfplan.txt",
                        fingerprint: true
                    )
                }
            }
        }

        stage('Plan Review') {
            steps {
                dir(env.WORKING_DIR) {
                    bat 'type tfplan.txt'
                }
            }
        }

        stage('Manual Approval') {
            when {
                expression {
                    !params.PLAN_ONLY &&
                    (
                        params.ENVIRONMENT == 'stage' ||
                        params.ENVIRONMENT == 'prod' ||
                        params.DESTROY
                    )
                }
            }

            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: "Approve Terraform ${params.DESTROY ? 'DESTROY' : 'APPLY'} for ${params.ENVIRONMENT}?",
                        ok: 'Approve'
                    )
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    !params.PLAN_ONLY && !params.DESTROY
                }
            }

            steps {
                dir(env.WORKING_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        bat '"C:\\terraform\\terraform.exe" apply -input=false -auto-approve tfplan'
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            when {
                expression {
                    !params.PLAN_ONLY && params.DESTROY
                }
            }

            steps {
                dir(env.WORKING_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        bat '"C:\\terraform\\terraform.exe" apply -destroy -input=false -auto-approve tfplan'
                    }
                }
            }
        }

        stage('Post-Apply Outputs') {
            when {
                expression {
                    !params.PLAN_ONLY && !params.DESTROY
                }
            }

            steps {
                dir(env.WORKING_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        bat '"C:\\terraform\\terraform.exe" output -json > terraform-outputs.json'

                        archiveArtifacts(
                            artifacts: 'terraform-outputs.json',
                            fingerprint: true
                        )
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Terraform pipeline completed successfully for ${params.ENVIRONMENT}"
        }

        failure {
            echo "Terraform pipeline failed for ${params.ENVIRONMENT}"
        }

        always {
            script {
                if (fileExists("${env.WORKING_DIR}/tfplan")) {
                    bat "del /f /q \"${env.WORKING_DIR}\\tfplan\""
                }

                if (fileExists("${env.WORKING_DIR}/tfplan.txt")) {
                    bat "del /f /q \"${env.WORKING_DIR}\\tfplan.txt\""
                }
            }

            cleanWs()
        }
    }
}