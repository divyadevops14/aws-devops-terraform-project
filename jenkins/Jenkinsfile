// =============================================================================
// TERRAFORM CI/CD PIPELINE - WINDOWS JENKINS
// All stages always execute (none are skipped via `when`). Conditional logic
// lives inside each stage, which logs what it did or why it took no action.
// =============================================================================

pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'stage', 'prod'],
            description: 'Select the Terraform environment'
        )

        booleanParam(
            name: 'PLAN_ONLY',
            defaultValue: false,
            description: 'Only generate and review a Terraform plan'
        )

        booleanParam(
            name: 'DESTROY',
            defaultValue: false,
            description: 'Destroy infrastructure instead of applying changes'
        )
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        TF_IN_AUTOMATION   = 'true'
        TF_CLI_ARGS        = '-no-color'
        WORKING_DIR        = "environments/${params.ENVIRONMENT}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                bat '"C:\\terraform\\terraform.exe" version'
            }
        }

        stage('Terraform Format Check') {
            steps {
                bat '"C:\\terraform\\terraform.exe" fmt -check -recursive -diff .'
            }
        }

        stage('Terraform Validate') {
            steps {
                dir(env.WORKING_DIR) {
                    bat '"C:\\terraform\\terraform.exe" init -backend=false -input=false'
                    bat '"C:\\terraform\\terraform.exe" validate'
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir(env.WORKING_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        )
                    ]) {
                        bat '"C:\\terraform\\terraform.exe" init -input=false -reconfigure'
                    }
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir(env.WORKING_DIR) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-creds',
                            usernameVariable: 'AWS_ACCESS_KEY_ID',
                            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                        ),
                        string(
                            credentialsId: 'db-password',
                            variable: 'TF_VAR_db_password'
                        )
                    ]) {
                        script {
                            if (params.DESTROY) {
                                bat '"C:\\terraform\\terraform.exe" plan -destroy -input=false -out=tfplan'
                            } else {
                                bat '"C:\\terraform\\terraform.exe" plan -input=false -out=tfplan'
                            }
                        }

                        bat '"C:\\terraform\\terraform.exe" show -no-color tfplan > tfplan.txt'
                    }
                }
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: "${env.WORKING_DIR}/tfplan.txt",
                        fingerprint: true
                    )
                }
            }
        }

        stage('Plan Review') {
            steps {
                dir(env.WORKING_DIR) {
                    bat 'type tfplan.txt'
                }
            }
        }

        stage('Manual Approval') {
            steps {
                script {
                    boolean needsApproval = !params.PLAN_ONLY &&
                        (params.ENVIRONMENT == 'stage' || params.ENVIRONMENT == 'prod' || params.DESTROY)

                    if (needsApproval) {
                        timeout(time: 30, unit: 'MINUTES') {
                            input(
                                message: "Approve Terraform ${params.DESTROY ? 'DESTROY' : 'APPLY'} for ${params.ENVIRONMENT}?",
                                ok: 'Approve'
                            )
                        }
                    } else if (params.PLAN_ONLY) {
                        echo 'PLAN_ONLY is set - no approval needed.'
                    } else {
                        echo "No manual approval required for ${params.ENVIRONMENT}."
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                script {
                    if (params.PLAN_ONLY) {
                        echo 'PLAN_ONLY is set - nothing to apply.'
                    } else if (params.DESTROY) {
                        echo 'DESTROY is set - handled in the Terraform Destroy stage.'
                    } else {
                        dir(env.WORKING_DIR) {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'aws-creds',
                                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                                )
                            ]) {
                                bat '"C:\\terraform\\terraform.exe" apply -input=false -auto-approve tfplan'
                            }
                        }
                    }
                }
            }
        }

        stage('Terraform Destroy') {
            steps {
                script {
                    if (params.PLAN_ONLY) {
                        echo 'PLAN_ONLY is set - nothing to destroy.'
                    } else if (!params.DESTROY) {
                        echo 'DESTROY not selected - nothing to destroy.'
                    } else {
                        dir(env.WORKING_DIR) {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'aws-creds',
                                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                                )
                            ]) {
                                bat '"C:\\terraform\\terraform.exe" apply -input=false -auto-approve tfplan'
                            }
                        }
                    }
                }
            }
        }

        stage('Post-Apply Outputs') {
            steps {
                script {
                    if (params.PLAN_ONLY || params.DESTROY) {
                        echo 'No outputs to collect for plan-only or destroy runs.'
                    } else {
                        dir(env.WORKING_DIR) {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: 'aws-creds',
                                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                                )
                            ]) {
                                bat '"C:\\terraform\\terraform.exe" output -json > terraform-outputs.json'

                                archiveArtifacts(
                                    artifacts: 'terraform-outputs.json',
                                    fingerprint: true
                                )
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Terraform pipeline completed successfully for ${params.ENVIRONMENT}"
        }

        failure {
            echo "Terraform pipeline failed for ${params.ENVIRONMENT}"
        }

        always {
            script {
                if (fileExists("${env.WORKING_DIR}/tfplan")) {
                    bat "del /f /q \"${env.WORKING_DIR}\\tfplan\""
                }

                if (fileExists("${env.WORKING_DIR}/tfplan.txt")) {
                    bat "del /f /q \"${env.WORKING_DIR}\\tfplan.txt\""
                }
            }

            cleanWs()
        }
    }
}